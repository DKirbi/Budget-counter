{
  "name": "@tbc/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start:dev-client": "expo start --dev-client",
    "prebuild": "expo prebuild --platform android --clean",
    "build:apk:debug": "expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug",
    "build:apk:release": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "export:check": "expo export --platform android --output-dir ./.export-check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src",
    "test": "jest",
    "e2e": "maestro test .maestro"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tbc/core": "workspace:*",
    "@tbc/screens-native": "workspace:*",
    "@tbc/tokens": "workspace:*",
    "@tbc/ui-native": "workspace:*",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-mlkit-ocr": "0.2.7",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.12",
    "react-dom": "19.2.3",
    "typescript": "~5.9.3"
  }
}
