{
  "fontFamily": {
    "$type": "fontFamily",
    "$description": "System fonts keep the MVP dependency-free. Swap here when a brand typeface is chosen.",
    "sans": { "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    "mono": { "$value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
  },
  "fontSize": {
    "$type": "dimension",
    "xs": { "$value": "12px" },
    "sm": { "$value": "14px" },
    "base": { "$value": "16px" },
    "lg": { "$value": "18px" },
    "xl": { "$value": "20px" },
    "2xl": { "$value": "24px" },
    "3xl": { "$value": "30px" },
    "4xl": { "$value": "36px" },
    "5xl": { "$value": "48px" }
  },
  "lineHeight": {
    "$type": "dimension",
    "$description": "Paired 1:1 with fontSize keys.",
    "xs": { "$value": "16px" },
    "sm": { "$value": "20px" },
    "base": { "$value": "24px" },
    "lg": { "$value": "28px" },
    "xl": { "$value": "28px" },
    "2xl": { "$value": "32px" },
    "3xl": { "$value": "36px" },
    "4xl": { "$value": "40px" },
    "5xl": { "$value": "52px" }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "normal": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  }
}
