{
  "name": "@tbc/screens-native",
  "version": "0.1.0",
  "private": true,
  "description": "Screens and user flows for the React Native app. Router-agnostic: navigation is injected as callbacks so the same screens run in Expo Router, Jest and Storybook.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest"
  },
  "dependencies": {
    "@tbc/core": "workspace:*",
    "@tbc/tokens": "workspace:*",
    "@tbc/ui-native": "workspace:*",
    "react-hook-form": "^7.90.0"
  },
  "peerDependencies": {
    "nativewind": "^4.2.0",
    "react": ">=19",
    "react-native": ">=0.83",
    "react-native-safe-area-context": ">=5"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@storybook/react-native-web-vite": "^10.6.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.26",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "storybook": "^10.6.0",
    "tailwindcss": "3.4.19",
    "typescript": "~5.9.3"
  }
}
